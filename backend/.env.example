# Puerto del servidor (Render lo define automáticamente)
PORT=4000

# Orígenes permitidos por CORS, separados por coma.
# En local usa la URL de tu frontend; en producción la URL de Vercel/Netlify.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Credenciales de la cuenta de servicio de Firebase
# (Consola de Firebase > Configuración del proyecto > Cuentas de servicio > Generar nueva clave privada)
FIREBASE_PROJECT_ID=tu-proyecto-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@tu-proyecto-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nTU_CLAVE_PRIVADA_AQUI\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=tu-proyecto-id.appspot.com
